DESC coffee_sales;

-- Change the 'Date' column data type to DATE
ALTER TABLE coffee_sales
MODIFY COLUMN Date DATE;

-- Convert the date values from DD-MM-YYYY text format into MySQL DATE format
UPDATE coffee_sales
SET Date = STR_TO_DATE(Date, '%d-%m-%Y');

-- Disable MySQL Safe Update Mode to allow UPDATE statements without a key-based WHERE condition
SET SQL_SAFE_UPDATES = 0;

-- Again modify the 'Date' column to ensure it is stored as the DATE data type
ALTER TABLE coffee_sales
MODIFY COLUMN Date DATE;

-- Change the 'Time' column data type to TIME
ALTER TABLE coffee_sales
MODIFY COLUMN Time TIME;

-- Convert time values from HH.MM.SS format into MySQL TIME format
UPDATE coffee_sales
SET Time = STR_TO_DATE(Time, '%H.%i.%S');

-- Again modify the 'Time' column to ensure it is stored as the TIME data type
ALTER TABLE coffee_sales
MODIFY COLUMN Time TIME;


								-- Basic and Intermediate --

-- 1. What is the total revenue generated so far?
SELECT ROUND(SUM(money),2) total_revenue
FROM coffee_sales;

-- 2. How many total coffee orders have been placed in the entire dataset?
SELECT count(coffee_name) Total_Sold
FROM coffee_sales;

-- 3. List all the unique types of coffee sold in the shop.
SELECT coffee_name,count(coffee_name) Total_sold
FROM coffee_sales
GROUP BY 1;

-- 4. Compare the total revenue generated from 'Card' versus 'Cash' payments.
SELECT cash_type, ROUND(SUM(money),2) Total_Revenue
FROM coffee_sales
GROUP BY 1; -- 5 Which specific coffee name has the highest number of total orders?
SELECT coffee_name,count(*) Total_Orders
FROM coffee_sales
GROUP BY 1
ORDER By 2 DESC
LIMIt 1;

-- 6 Which time of the day (Morning, Afternoon, Night)  is the most profitable in term of revenue?
SELECT time_of_day, ROUND(SUM(money),2) Total_Revenue
FROM coffee_sales
GROUP BY 1
ORDER BY 2 DESC;

-- 7 Calculate total number of orders received for each day of the week?
SELECT weekday,COUNT(*) total_Order
FROM coffee_sales
GROUP BY 1
ORDER BY DAY(2) ASC;

-- 8. During which hour of the day (hour_of_day) do the highest sales occur?

SELECT hour_of_day,ROUND(SUM(money),2) Hourly_Revenue
FROM coffee_sales
GROUP BY 1
ORDER BY 2 DESC;

-- 9. Provide a monthly breakdown of total sales revenue.

SELECT month_name,ROUND(SUM(money),2) Monthly_Revenue
FROM coffee_sales
GROUP BY 1
ORDER BY 2 DESC;

-- 10. Identify the top 5 individual dates that generated the highest revenue.

SELECT date,ROUND(SUM(money),2) Daily_Revenu
FROM coffee_sales
GROUP BY 1;

											-- Level Up --

-- 11. For each 'Time_of_Day', find the top 2 best-selling coffees based on total revenue.

WITH Revenue AS (
SELECT coffee_name,time_of_day,ROUND(SUM(money),2) Total_Revenue
FROM coffee_sales
GROUP BY 1,2
)
SELECT time_of_day,coffee_name,Total_Revenue FROM (
SELECT *,
DENSE_RANK() OVER(PARTITION BY time_of_day ORDER BY total_revenue DESC) ranking
FROM revenue ) Summary
WHERE ranking <=2;


-- 12. Create a report showing the daily revenue alongside a cumulative (running) total of revenue over time.

WITH revenue AS (
SELECT Date,ROUND(sum(money),2) Weekly_Revenue
FROM coffee_sales
GROUP By 1
)
SELECT *,
ROUND(sum(Weekly_Revenue) OVER(ROWS BETWEEN UNBOUNDED 
							PRECEDING AND CURRENT ROW),2) Running_Total
FROM revenue;

-- 13. Calculate the percentage contribution of each coffee type to the total overall revenue of the shop.

WITH coffee_revenue AS (
						SELECT coffee_name,ROUND(SUM(money),2) Total_Revenue
						FROM coffee_sales
						GROUP BY 1
						)
SELECT *,
SUM(Total_Revenue) OVER() Overall_Revenue,
ROUND(Total_Revenue /
					SUM(Total_Revenue) OVER() * 100,2) pct_contri_by_coffee
FROM coffee_revenue;

-- 14. Determine the MOM growth percentage in total sales revenue for each Month.

WITH monthly_sales AS (
						SELECT month_name,
						ROUND(SUM(money),2) Total_Revenue
						FROM coffee_sales
						GROUP BY 1
						)
SELECT *,
LAG(Total_revenue) OVER() Previous_revenue,
ROUND( ( Total_Revenue - LAG(Total_revenue) OVER() ) 
				/ LAG(Total_revenue) OVER()*100,2) Growth_Percentage 
FROM monthly_sales;

-- 15. Calculate each month's total sales, calculate the average of all monthly totals, and find the months whose sales are above that average.

WITH monthly_sales AS (
						SELECT month_name,
						ROUND(SUM(money),2) Total_Sales
						FROM coffee_sales
						GROUP BY 1
						),
Overall AS 				(
						SELECT *,
						ROUND(AVG(total_sales) OVER(),2) Avg_Sales
						FROM monthly_sales
						)
SELECT * 
FROM overall
WHERE Total_Sales >= Avg_Sales;
































